{
  "schema_version": 2,
  "provider": "openai_compatible",
  "models": {
    "chat": {
      "enabled": true,
      "base_url": "",
      "base_url_env": "MODEL_CHAT_BASE_URL",
      "path": "/chat/completions",
      "model": "deepseek-v4-flash",
      "send_model": true,
      "api_key_env": "MODEL_CHAT_API_KEY",
      "authentication": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "timeout_seconds": 60.0,
      "extra_body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "temperature": 0.0,
      "max_tokens": 2048,
      "response_format": "json_object",
      "send_response_format": true,
      "enable_thinking": false,
      "send_enable_thinking": false,
      "user_message_suffix": "",
      "chat_template_kwargs": {}
    },
    "embedding": {
      "enabled": false,
      "base_url": "",
      "base_url_env": "",
      "path": "",
      "model": "",
      "send_model": true,
      "api_key_env": "",
      "authentication": {
        "type": "none",
        "header": "Authorization",
        "prefix": ""
      },
      "timeout_seconds": 60.0,
      "extra_body": {},
      "dimensions": null,
      "encoding_format": "float",
      "user": null
    },
    "reranker": {
      "enabled": false,
      "base_url": "",
      "base_url_env": "",
      "path": "",
      "model": "",
      "send_model": true,
      "api_key_env": "",
      "authentication": {
        "type": "none",
        "header": "Authorization",
        "prefix": ""
      },
      "timeout_seconds": 60.0,
      "extra_body": {},
      "top_n": 20,
      "return_documents": false,
      "send_top_n": true,
      "send_return_documents": true,
      "documents_field": "documents"
    }
  }
}
