APP_NAME=Ask Metric Backend Next
APP_ENV=development
LOG_LEVEL=INFO
# Development keeps console logs. Production automatically defaults to files.
LOG_FILE_ENABLED=false
LOG_CONSOLE_ENABLED=true
LOG_DIRECTORY=/home/appuser/log
LOG_DATA_CENTER_ID=-
LOG_ZONE_ID=-
LOG_MAX_BYTES=52428800
LOG_RETENTION_DAYS=3
LOG_MAX_LINE_BYTES=204800
# 40位全局流水号变量。生产环境替换为CMDB和云主机注入值；取不到时使用规范兜底值。
APP_NODE_CODE=8888888
APP_IDC=888
APP_UNIT=8
HOST=127.0.0.1
PORT=8010

# Nacos is optional for direct local development. Enable it when traffic enters
# through Gateway. Multiple cluster nodes are separated with commas.
NACOS_ENABLED=false
NACOS_SERVER_ADDR=192.0.2.11:8848,192.0.2.12:8848,192.0.2.13:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_SERVICE_NAME=ask-metric-python
NACOS_CLUSTER_NAME=DEFAULT
NACOS_INSTANCE_IP=192.0.2.10
NACOS_INSTANCE_PORT=8010
NACOS_INSTANCE_ID=ask-metric-01
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_EPHEMERAL=true
NACOS_REQUEST_TIMEOUT_MS=5000
NACOS_FAIL_FAST=false
NACOS_CACHE_DIR=.runtime/nacos/cache
NACOS_LOG_DIR=.runtime/nacos/logs

# Application data (users, catalogs, conversations, tasks, and audit logs).
APP_DATABASE_URL=mysql+pymysql://ask_metric_app@goldendb.example:3306/ask_metric_app?charset=utf8mb4
APP_DATABASE_DIALECT=mysql
# Read-only GoldenDB/MySQL business metric queries. Always use a read-only account.
QUERY_DATABASE_URL=mysql+pymysql://metric_readonly@goldendb.example:3306/business_metrics?charset=utf8mb4
QUERY_DATABASE_DIALECT=mysql
# SIT example (never commit real hosts, users, or passwords):
# QUERY_DATABASE_DIALECT=inceptor
# QUERY_DATABASE_URL=mysql+pymysql://readonly_user@data-lake.example:3306/default
# Catalog synchronization and fact queries share QUERY_DATABASE_URL.
SIT_FACT_TABLE=ads_lake.adm_rmt_pub_gnrl_drv_indcr_tab
SIT_METRIC_CONFIG_TABLE=ads_lake.adm_rmt_pub_drv_indcr_cnfgon_infotab
SIT_ORG_TABLE=ads_lake.fdm_pub_org_inf_all
# Current SIT physical columns. Production deployments override these mappings;
# Python and the governed Inceptor templates keep stable internal aliases.
SIT_FACT_METRIC_CODE_FIELD=indcr_no
SIT_FACT_SOURCE_METRIC_CODE_FIELD=orig_indcr_no
SIT_FACT_VALUE_BASIS_FIELD=indcr_nm
SIT_FACT_ORG_CODE_FIELD=org_no
SIT_FACT_DATA_DATE_FIELD=data_dt
SIT_FACT_VALUE_FIELD=indcvl
SIT_FACT_INCREMENT_FIELD=indcvl_incrrng
SIT_FACT_BATCH_SEQUENCE_FIELD=btch_seq_no
SIT_METRIC_CONFIG_CODE_FIELD=indcr_no
SIT_METRIC_CONFIG_NAME_FIELD=indcr_nm
SIT_METRIC_CONFIG_EFFECTIVE_DATE_FIELD=eff_dt
SIT_METRIC_CONFIG_VERSION_FIELD=indcr_ver_no
SIT_METRIC_CONFIG_BATCH_FIELD=btch_seq_no
SIT_ORG_CODE_FIELD=org_no
SIT_ORG_NAME_FIELD=org_chn_nm
SIT_ORG_CORPORATION_CODE_FIELD=corpt_no
SIT_ORG_HIERARCHY_FIELD=org_hier_code
# Catalog snapshots: final indicator codes come from the latest fact load; organizations
# come from the latest organization-dimension snapshot.
SIT_METRIC_FACT_SNAPSHOT_FIELD=etl_date
SIT_ORG_SNAPSHOT_FIELD=etl_date
SIT_ORG_CORPORATION_CODE_MAX=134
SIT_ORG_EXCLUDED_CORPORATION_CODE=086
SIT_ORG_HEAD_OFFICE_CORPORATION_CODE=000
SIT_ORG_LEGAL_ENTITY_HIER_CODE=3
SIT_ORG_HEAD_OFFICE_HIER_CODE=1
SIT_ORG_EXPECTED_COUNT=61
# Compatibility setting only. Runtime queries always filter by data_dt and never
# constrain etl_date to the requested business-date range.
SIT_PARTITION_MODE=none
SIT_BATCH_ORDER=etl_date DESC, btch_seq_no DESC
SIT_METRIC_ACTIVE_ORDER=eff_dt,indcr_ver_no,btch_seq_no
SIT_LATEST_PARTITION_LOOKBACK_DAYS=1095
# Optional statements separated by ||. Empty by default because Inceptor is not MySQL.
QUERY_SESSION_INIT_STATEMENTS=
CORS_ORIGINS=http://localhost:5173
SQL_ECHO=false

# Schema-changing Alembic commands are denied unless explicitly enabled.
BACKEND_NEXT_ALLOW_SCHEMA_CHANGES=false
BACKEND_NEXT_ALLOW_NON_TEST_DATABASE=false

# Replace outside local development. Tokens are signed and expire automatically.
CONTINUATION_TOKEN_SECRET=
CONTINUATION_TOKEN_TTL_SECONDS=86400

# Each model role can use its own credential. Values stay in .env and are never returned.
MODEL_CHAT_API_KEY=
MODEL_EMBEDDING_API_KEY=
MODEL_RERANK_API_KEY=
MODEL_CHAT_BASE_URL=
MODEL_EMBEDDING_BASE_URL=
MODEL_RERANK_BASE_URL=
MODEL_CONFIG_PATH=config/model-config.json
MODEL_SECRET_ENV_PATH=.env
PROMPT_CONFIG_PATH=config/prompts.json
SEMANTIC_CONFIG_PATH=config/semantic-config.json
QUERY_TEMPLATE_CONFIG_PATH=config/query-templates.json
SQL_RESOURCE_DIR=resources/sql
QUERY_RESULT_LIMIT=1000
QUERY_STATEMENT_TIMEOUT_MS=30000

# Development defaults to direct writes by an authenticated SYSTEM_ADMIN. These
# explicit values document that behavior. Token bypass is rejected outside dev/test.
MODEL_ADMIN_WRITE_ENABLED=true
MODEL_ADMIN_TOKEN_REQUIRED=false
MODEL_ADMIN_TOKEN=
TRUSTED_PROXY_TOKEN=
# Digital Rural Commercial Bank SSO. Keep disabled until the upstream URL is reachable.
SSO_ENABLED=false
SSO_USER_INFO_URL=https://your-digital-rural-platform.example/yusp-app-oca/api/ssoconfig/userInfo
SSO_TIMEOUT_SECONDS=10
SSO_SOURCE_SYSTEM=jsrcb
JWT_SECRET=
JWT_ALGORITHM=HS256
# 固定登录有效期（分钟）；刷新只恢复原会话，不续期。修改后对新登录生效。
JWT_EXPIRE_MINUTES=480
JWT_ISSUER=ask-metric
JWT_AUDIENCE=ask-metric-web
# 登录国密传输的 SM2 私钥（64 位 hex）。开发/测试缺省时后端使用进程级临时密钥，
# 生产环境必须配置独立的随机私钥，且不得提交到 Git。
SM2_PRIVATE_KEY=

# Production encrypted-secret support. Keep the 32-hex-character SM4 key in a
# separate permission-protected file, never in this .env file. Values produced by
# `python -m ask_metric encrypt-config --key-file <path>` may replace any password,
# database URL, token, API key, JWT secret, or SM2 private key above.
ASK_METRIC_CONFIG_SM4_KEY_FILE=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
MODEL_MAX_CONNECTIONS=20
MODEL_MAX_KEEPALIVE_CONNECTIONS=10
MODEL_MAX_CONCURRENCY=8
MODEL_CONCURRENCY_WAIT_SECONDS=30
METRIC_CATALOG_CACHE_TTL_SECONDS=60
MAX_CONVERSATIONS_PER_USER=500
