{
  "schema_version": 2,
  "provider": "deepseek_openai_compatible",
  "models": {
    "chat": {
      "enabled": false,
      "base_url": "",
      "path": "/v1/chat/completions",
      "model": "deepseek-flash",
      "send_model": true,
      "api_key_env": "MODEL_CHAT_API_KEY",
      "authentication": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "timeout_seconds": 8,
      "extra_body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "temperature": 0.0,
      "max_tokens": 2048,
      "enable_thinking": false,
      "send_enable_thinking": false,
      "user_message_suffix": "",
      "chat_template_kwargs": {},
      "base_url_env": "MODEL_WORKFLOW_BASE_URL"
    },
    "embedding": {
      "enabled": true,
      "base_url": "",
      "base_url_env": "MODEL_WORKFLOW_BASE_URL",
      "path": "/v1/embeddings",
      "model": "BAAI/bge-m3",
      "send_model": true,
      "api_key_env": "MODEL_CHAT_API_KEY",
      "authentication": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "timeout_seconds": 8,
      "extra_body": {},
      "dimensions": null,
      "encoding_format": "float",
      "user": ""
    },
    "reranker": {
      "enabled": true,
      "base_url": "",
      "base_url_env": "MODEL_WORKFLOW_BASE_URL",
      "path": "/v1/rerank",
      "model": "BAAI/bge-reranker-v2-m3",
      "send_model": true,
      "api_key_env": "MODEL_CHAT_API_KEY",
      "authentication": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "timeout_seconds": 8,
      "extra_body": {},
      "top_n": 20,
      "return_documents": false,
      "send_top_n": true,
      "send_return_documents": true,
      "documents_field": "documents"
    }
  }
}
