{
  "name": "ask-metric-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b && vue-tsc --noEmit -p tsconfig.specs.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,css,json}\" \"specs/**/*.ts\" \"*.{ts,json,mjs,html}\" \"../.prettierrc.json\""
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "echarts": "^6.1.0",
    "highlight.js": "11.12.0",
    "markdown-it": "^15.0.2",
    "reka-ui": "^2.10.1",
    "sm-crypto": "^0.5.7",
    "sql-formatter": "15.9.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/node24": "^24.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "postcss": "^8.5.26",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.1.4",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.1.8"
  }
}
