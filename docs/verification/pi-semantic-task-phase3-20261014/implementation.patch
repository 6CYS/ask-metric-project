+export function addPlanBackend(backend: ReturnType<typeof syntheticBackend>) {
+  const inspectBusinessGoal = vi.fn(async (question: string) => {
+    const fragments = await Promise.all(question.split(/[；;，,]/u).filter(Boolean).map(async part => ({question: part,
+      organizations: ["O1", "O2"].filter((_, i) => part.includes(i ? "合成机构乙" : "合成机构甲")),
+      calendar: {ranges: /202[45]/u.test(part) ? [{start: part.includes("2024") ? "2024-12-31" : "2025-12-31", end: part.includes("2024") ? "2024-12-31" : "2025-12-31"}] : [], unresolved: []},
+      mentions: (await backend.matchMetricQuestion(part)).mentions})));
+    return {question, reference_year: null, fragments};
+  });
+  const admitSemanticPlan = vi.fn(async (payload: {steps: Array<{target_ref: string; fragment: number; spec: {org_codes: string[]; metric_codes: string[]; time: {start: string; end: string}}}>; goal: string}) => {
+    const goal = await inspectBusinessGoal(payload.goal);
+    for (const [index, fragment] of goal.fragments.entries()) {
+      const steps = payload.steps.filter(step => step.fragment === index);
+      if (!steps.length || fragment.organizations.some(org => !steps.some(step => step.spec.org_codes.includes(org)))
+        || fragment.mentions.some(mention => mention.resolution.status === "resolved" && (mention.resolution.value as {codes: string[]}).codes.some(code => !steps.some(step => step.spec.metric_codes.includes(code))))) {
+        throw new Error("PLAN_TARGETS_INCOMPLETE");
+      }
+    }
+    return {status: "admitted", receipts: payload.steps.map(step => ({target_ref: step.target_ref, receipt: "synthetic-server-receipt"}))};
+  });
+  Object.assign(backend, {inspectBusinessGoal, admitSemanticPlan});
+  return {inspectBusinessGoal, admitSemanticPlan};
+}
