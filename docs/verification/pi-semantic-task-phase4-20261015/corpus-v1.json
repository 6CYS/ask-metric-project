{
  "version": "phase4-local-acceptance-v1",
  "purpose": "新表述功能对照与重复稳定性；非真实分布语料，不用于95%验收",
  "oracle": "事先固定的业务目标、合成事实和执行证据；不从候选任务账本生成期望",
  "cases": [
    {
      "id": "colloquial_exact",
      "group": "exact",
      "messages": [
        "帮我看一下合成机构丙2026年5月30日的经营收益金额当日数。"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ]
        }
      ]
    },
    {
      "id": "iso_date",
      "group": "exact",
      "messages": [
        "合成机构丙的经营收益金额当日数，日期是2026-05-30，麻烦查一下"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ]
        }
      ]
    },
    {
      "id": "metric_before_org",
      "group": "exact",
      "messages": [
        "经营收益金额当日数：2026年5月30日，合成机构丙"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ]
        }
      ]
    },
    {
      "id": "missing_date_followup",
      "group": "clarification",
      "messages": [
        "想看合成机构丙的经营收益金额当日数",
        "2026年5月30日"
      ],
      "expect": [
        {
          "no_query": true,
          "needs_user": true
        },
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ]
        }
      ]
    },
    {
      "id": "basis_confirmation",
      "group": "clarification",
      "messages": [
        "查合成机构丙2026年5月30日的经营收益金额",
        "用经营收益金额当日数这个指标"
      ],
      "expect": [
        {
          "no_query": true,
          "needs_user": true
        },
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ]
        }
      ]
    },
    {
      "id": "catalog_typo",
      "group": "exact",
      "messages": [
        "查合成机构丙2026年5月30日的经营收益金融当日数"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ]
        }
      ]
    },
    {
      "id": "shared_two_metrics",
      "group": "multi_metric",
      "messages": [
        "合成机构丙，2026年5月30日，经营收益金额当日数和经营收益金额较同期都查一下"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            },
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:Y",
              "date": "2026-05-30"
            }
          ]
        }
      ]
    },
    {
      "id": "shared_two_orgs",
      "group": "multi_org",
      "messages": [
        "查合成机构甲、合成机构丙在2026年5月30日的经营收益金额当日数"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O1",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            },
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ]
        }
      ]
    },
    {
      "id": "bound_targets",
      "group": "composite",
      "messages": [
        "分别查询：合成机构丙2026年5月30日的经营收益金额当日数；合成机构甲2026年6月30日的经营收益金额较同期。"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            },
            {
              "org": "SYNTH_O1",
              "metric": "SYNTH_M:Y",
              "date": "2026-06-30"
            }
          ]
        }
      ]
    },
    {
      "id": "rank_top_two",
      "group": "ranking",
      "messages": [
        "合成机构甲、合成机构乙、合成机构丙，2026年5月30日经营收益金额当日数，从高到低前2名"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O1",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            },
            {
              "org": "SYNTH_O2",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            },
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ],
          "operation": {
            "kind": "ranking",
            "position": "top",
            "top_n": 2
          },
          "result_orgs": [
            "SYNTH_O2",
            "SYNTH_O3"
          ]
        }
      ]
    },
    {
      "id": "subject_position",
      "group": "position",
      "messages": [
        "合成机构丙2026年5月30日的经营收益金额当日数，在合成机构甲、合成机构乙、合成机构丙这三家中排第几？"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ],
          "operation": {
            "kind": "rank_position"
          },
          "comparison_orgs": [
            "SYNTH_O1",
            "SYNTH_O2",
            "SYNTH_O3"
          ]
        }
      ]
    },
    {
      "id": "cross_org_difference",
      "group": "calculation",
      "messages": [
        "查询合成机构甲和合成机构丙2026年5月30日的经营收益金额当日数，并计算丙减甲的差额。"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O1",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            },
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ],
          "calculation": true,
          "calculation_value": "10"
        }
      ]
    },
    {
      "id": "result_driven_new_variant",
      "group": "analysis",
      "messages": [
        "分析合成机构丙2026年5月30日的经营收益金额当日数和经营收益金额较同期。请先取得当日数结果，看到结果后再补查较同期，并结合两项结果说明。"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            },
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:Y",
              "date": "2026-05-30"
            }
          ],
          "staged": true
        }
      ]
    },
    {
      "id": "historical_date_change",
      "group": "history",
      "messages": [
        "查合成机构丙2026年5月30日的经营收益金额当日数",
        "日期改成2026年6月30日，其他条件不变"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ]
        },
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-06-30"
            }
          ]
        }
      ]
    },
    {
      "id": "empty_result",
      "group": "empty",
      "messages": [
        "查合成机构丙2026年7月31日的经营收益金额当日数"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O3",
              "metric": "SYNTH_M:D",
              "date": "2026-07-31"
            }
          ],
          "empty": true
        }
      ]
    },
    {
      "id": "null_value",
      "group": "null",
      "messages": [
        "查合成机构丁2026年5月30日的经营收益金额当日数"
      ],
      "expect": [
        {
          "tuples": [
            {
              "org": "SYNTH_O4",
              "metric": "SYNTH_M:D",
              "date": "2026-05-30"
            }
          ],
          "null": true
        }
      ]
    }
  ],
  "stability": {
    "case_ids": [
      "iso_date",
      "bound_targets",
      "cross_org_difference"
    ],
    "repetitions": 10,
    "repetitions_do_not_increase_independent_sample_size": true
  }
}
