import {createCapabilities} from '../../../agent-service/src/business-context/capabilities.ts';
import {BusinessContextService} from '../../../agent-service/src/business-context/service.ts';
import {createFieldResolvers} from '../../../agent-service/src/business-context/resolvers.ts';
import {fromFixedTurnArgs} from '../../../agent-service/src/business-context/fixedTurnArgs.ts';
import {resolveHistoryFieldReference} from '../../../agent-service/src/business-context/historyReferences.ts';
console.info=()=>{};
const resolved=(value:any)=>({source:'explicit',resolutionStatus:'resolved',resolvedValue:value});
const baseFields=()=>({metrics:resolved({codes:['M'],names:['合成指标']}),organizations:resolved({codes:['O1','O2'],names:['合成机构甲','合成机构乙']}),time:resolved({start:'2026-04-30',end:'2026-04-30'}),selection:resolved('exact'),operation:resolved({kind:'value'}),comparison_organizations:{source:'explicit',resolutionStatus:'missing'}});
const frame=(id:string,status='success',fields:any=baseFields())=>({frameId:id,sessionId:'s',turnId:'t1',requestId:'r1',capability:'metric_query',operationFrameId:id,fields,delta:{capabilityHint:'metric_query',baseReference:null,executionMode:'execute',fieldChanges:[]},issues:[],status,createdAt:new Date().toISOString()});
class MemoryStore {
 stateData:any; frames=new Map<string,any>(); commands=new Map<string,string>();
 constructor(frames:any[],focus:string,operations:any){for(const f of frames)this.frames.set(f.frameId,structuredClone(f));this.stateData={sessionId:'s',version:frames.length,frameOrder:frames.map(x=>x.frameId),operations,focusFrameId:focus};}
 async state(){return structuredClone(this.stateData)} async get(id:string){return structuredClone(this.frames.get(id))} async list(){return [...this.frames.values()].map(x=>structuredClone(x))} async command(key:string){return this.get(this.commands.get(key)!)}
 async save(f:any,v:number,key:string,focus=true){if(v!==this.stateData.version)throw new Error('conflict');this.frames.set(f.frameId,structuredClone(f));this.commands.set(key,f.frameId);this.stateData={...this.stateData,version:v+1,frameOrder:[...this.stateData.frameOrder,f.frameId],operations:{...this.stateData.operations,[f.operationFrameId]:f.frameId},...(focus&&f.status!=='failed'?{focusFrameId:f.frameId}:{})};return structuredClone(f)}
}
const identity={sessionId:'s',turnId:'t2',requestId:'r2'};
const catalogCalls:any[]=[];
const catalog=async(entity:string,raw:string[])=>{catalogCalls.push([entity,raw]);if(entity==='organization')return {status:'resolved',value:{codes:raw,names:raw.map(x=>x==='O1'?'合成机构甲':'合成机构乙')}};if(entity==='date')return {status:'resolved',value:{start:'2026-04-03',end:'2026-04-03'}};throw new Error('unexpected catalog call')};
async function inflight(){for(const base of ['current',{frameId:'R'}]){const r=frame('R','ready');const e={...r,frameId:'E',parentFrameId:'R',status:'executing'};const store=new MemoryStore([r,e],'E',{R:'E'});const service=new BusinessContextService(store as any,createCapabilities(),createFieldResolvers());let reconciles=0;const result=await service.resolve(fromFixedTurnArgs({protocol_version:1,capability:'metric_query',base,mode:'execute',changes:{organizations:{action:'inherit'}}}),identity,{originalMessage:'再查一次',currentDate:'2026-10-14',turnId:'t2',requireFieldIntents:true,resolveCatalog:catalog,reconcileExecution:async()=>{reconciles++;return undefined;}});console.log('inflight-fixed-service',JSON.stringify({base,reconciles,status:result.status,issues:result.issues}));}}
async function count(){const store=new MemoryStore([frame('H')],'H',{H:'H'});const service=new BusinessContextService(store as any,createCapabilities(),createFieldResolvers());const originalMessage='查询以上三家机构';const context:any={originalMessage,currentDate:'2026-10-14',turnId:'t2',requireFieldIntents:true,resolveCatalog:catalog};context.resolveFieldReference=async(input:any,targetField:string,inputSource:any,previous:any)=>resolveHistoryFieldReference(input,targetField,{sessionId:'s',turnId:'t2',originalMessage,inputSource,previous,state:await store.state(),frames:await store.list(),resolveCatalog:catalog} as any);const result=await service.resolve(fromFixedTurnArgs({protocol_version:1,capability:'metric_query',base:{frameId:'H'},mode:'execute',changes:{organizations:{action:'set',source_text:'以上三家机构',expected_count:2,value:{kind:'history',combine:'single',sources:[{frame:{frameId:'H'},field:'organizations'}]}}}}),identity,context);console.log('count-fixed-service-history',JSON.stringify({originalMessage,status:result.status,issues:result.issues,organizations:result.fields.organizations,catalogCalls}));}
async function dateConfirmation(){const f=baseFields() as any;const candidates=[1,2,3].map(x=>({code:'M'+x,value:'合成指标'+x,metadata:{rawValueIndex:0}}));f.metrics={source:'explicit',rawValue:['模糊指标'],resolutionStatus:'ambiguous',candidates,metadata:{candidateTurnId:'t1',questionText:'模糊指标',mentionResolutions:[{text:'模糊指标',start:0,end:4,status:'ambiguous',candidates}]}};const store=new MemoryStore([frame('P','clarifying',f)],'P',{P:'P'});const service=new BusinessContextService(store as any,createCapabilities(),createFieldResolvers());const originalMessage='日期改成2026年4月3号';const result=await service.resolve(fromFixedTurnArgs({protocol_version:1,capability:'metric_query',base:{frameId:'P'},mode:'execute',changes:{organizations:{action:'inherit'},time:{action:'set',value:'2026年4月3号'}}}),identity,{originalMessage,currentDate:'2026-10-14',turnId:'t2',requireFieldIntents:true,resolveCatalog:catalog});console.log('date-fixed-service-confirmation',JSON.stringify({originalMessage,modelChangedFields:['organizations inherit','time set'],status:result.status,issues:result.issues,metrics:result.fields.metrics,time:result.fields.time}));}
await inflight();await count();await dateConfirmation();
