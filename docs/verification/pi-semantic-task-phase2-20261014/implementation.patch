+import {runTool} from "../../src/tools/testUtils.js";
+import type {BackendClient} from "../../src/backendClient.js";
+import {fixture, proposal} from "./fixtures.js";
+const clean: Array<() => Promise<void>> = [];
+afterEach(async () => {for (const close of clean.splice(0)) await close();});
+const cache = new Map<string, any>();
+function python(payload: unknown): any {
+  const input = JSON.stringify(payload);
+  if (cache.has(input)) return structuredClone(cache.get(input));
+  const output = JSON.parse(execFileSync(resolve("../backend-next/.venv/bin/python"), [resolve("scripts/semantic-task-fixture.py")],
+    {input, encoding: "utf8", timeout: 30000, env: {PATH: "/usr/bin:/bin:/opt/homebrew/bin"}}));
+  expect(output.ok, output.message).toBe(true); cache.set(input, output.value); return output.value;
+}
+async function setup() {
+  const f = await fixture(); clean.push(f.close);
+  const request = (id: string, message: string) => ({...f.request(id, message), backend: {
+    ...f.backend,
+    resolveBusinessField: async (entity: string, raw: string[], _options?: unknown, year?: number, source?: unknown) => python({action: "resolve", entity, raw, year, source}),
+    matchMetricQuestion: async (question: string) => python({action: "mentions", question}),
+  } as unknown as BackendClient});
+  return {...f, request};
+}
+const base = [
+  {action: "set", field: "organizations", value: "合成机构甲"},
+  {action: "set", field: "metrics", value: "经营收益金额当日数"},
+  {action: "set", field: "time", value: "2026年5月31日"},
+] as const;
