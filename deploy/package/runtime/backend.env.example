# Copy to /etc/ask-metric/backend.env and replace every angle-bracket placeholder.
# Generate ENC[SM4:v1:...] values with the backend encrypt-config command.
APP_NAME=<bank-application-name>
APP_ENV=production
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=false
LOG_DIRECTORY=/home/appuser/log
# Replace these placeholders with the bank resource allocation values.
LOG_DATA_CENTER_ID=<data-center-id>
LOG_ZONE_ID=<zone-id>
LOG_MAX_BYTES=52428800
LOG_RETENTION_DAYS=3
LOG_MAX_LINE_BYTES=204800
# Gateway nodes must be able to reach NACOS_INSTANCE_IP:NACOS_INSTANCE_PORT.
# Restrict this port to the Gateway network with the host firewall.
HOST=0.0.0.0
PORT=@BACKEND_PORT@

# Nacos service discovery. Namespace, group, cluster, and service name must
# exactly match the Gateway configuration.
NACOS_ENABLED=true
NACOS_SERVER_ADDR=<nacos-node-1>:8848,<nacos-node-2>:8848,<nacos-node-3>:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_SERVICE_NAME=ask-metric-python
NACOS_CLUSTER_NAME=DEFAULT
# Register an address reachable from Gateway; never use 127.0.0.1 across hosts.
NACOS_INSTANCE_IP=<backend-host-private-ip>
NACOS_INSTANCE_PORT=@BACKEND_PORT@
NACOS_INSTANCE_ID=ask-metric-01
NACOS_USERNAME=<nacos-username>
NACOS_PASSWORD=<sm4-encrypted-nacos-password>
NACOS_EPHEMERAL=true
NACOS_REQUEST_TIMEOUT_MS=5000
NACOS_FAIL_FAST=false
# systemd permits writes below STATE_ROOT; the immutable release tree is read-only.
NACOS_CACHE_DIR=@STATE_ROOT@/nacos/cache
NACOS_LOG_DIR=@STATE_ROOT@/nacos/logs

# Application metadata/audit database: read-write account.
APP_DATABASE_URL=<sm4-encrypted-app-database-url>
APP_DATABASE_DIALECT=mysql

# SIT data lake: dedicated read-only account. The Inceptor endpoint exposes a
# MySQL-compatible wire protocol, while SQL generation uses the inceptor dialect.
QUERY_DATABASE_URL=<sm4-encrypted-query-database-url>
QUERY_DATABASE_DIALECT=inceptor
# Metric catalog, organization catalog, and fact queries all use this same
# QUERY_DATABASE_URL. No additional catalog connection is required.

SIT_FACT_TABLE=ads_lake.adm_rmt_pub_gnrl_drv_indcr_tab
SIT_METRIC_CONFIG_TABLE=ads_lake.adm_rmt_pub_drv_indcr_cnfgon_infotab
SIT_ORG_TABLE=ads_lake.fdm_pub_org_inf_all
# These are current SIT physical columns, not a production contract. Confirm and
# override every changed table/column name before production deployment.
SIT_FACT_METRIC_CODE_FIELD=indcr_no
SIT_FACT_SOURCE_METRIC_CODE_FIELD=orig_indcr_no
SIT_FACT_VALUE_BASIS_FIELD=indcr_nm
SIT_FACT_ORG_CODE_FIELD=org_no
SIT_FACT_DATA_DATE_FIELD=data_dt
SIT_FACT_VALUE_FIELD=indcvl
SIT_FACT_INCREMENT_FIELD=indcvl_incrrng
SIT_FACT_BATCH_SEQUENCE_FIELD=btch_seq_no
SIT_METRIC_CONFIG_CODE_FIELD=indcr_no
SIT_METRIC_CONFIG_NAME_FIELD=indcr_nm
SIT_METRIC_CONFIG_EFFECTIVE_DATE_FIELD=eff_dt
SIT_METRIC_CONFIG_VERSION_FIELD=indcr_ver_no
SIT_METRIC_CONFIG_BATCH_FIELD=btch_seq_no
SIT_ORG_CODE_FIELD=org_no
SIT_ORG_NAME_FIELD=org_chn_nm
SIT_ORG_CORPORATION_CODE_FIELD=corpt_no
SIT_ORG_HIERARCHY_FIELD=org_hier_code
SIT_METRIC_FACT_SNAPSHOT_FIELD=etl_date
SIT_ORG_SNAPSHOT_FIELD=etl_date
SIT_ORG_CORPORATION_CODE_MAX=134
SIT_ORG_EXCLUDED_CORPORATION_CODE=086
SIT_ORG_HEAD_OFFICE_CORPORATION_CODE=000
SIT_ORG_LEGAL_ENTITY_HIER_CODE=3
SIT_ORG_HEAD_OFFICE_HIER_CODE=1
SIT_ORG_EXPECTED_COUNT=61
SIT_PARTITION_MODE=none
SIT_BATCH_ORDER=etl_date DESC, btch_seq_no DESC
SIT_METRIC_ACTIVE_ORDER=eff_dt,indcr_ver_no,btch_seq_no
SIT_LATEST_PARTITION_LOOKBACK_DAYS=1095
QUERY_SESSION_INIT_STATEMENTS=

CONTINUATION_TOKEN_SECRET=<sm4-encrypted-continuation-token-secret>
JWT_SECRET=<sm4-encrypted-jwt-secret>
ASK_METRIC_CONFIG_SM4_KEY_FILE=/etc/ask-metric/config-sm4.key
SM2_PRIVATE_KEY=<sm4-encrypted-sm2-private-key>
# Model credentials are referenced by MODEL_* names in model-config.json.
MODEL_CHAT_API_KEY=
MODEL_EMBEDDING_API_KEY=
MODEL_RERANK_API_KEY=
MODEL_CHAT_BASE_URL=
MODEL_EMBEDDING_BASE_URL=
MODEL_RERANK_BASE_URL=
CORS_ORIGINS=http://<service-host>

MODEL_CONFIG_PATH=@STATE_ROOT@/runtime-config/model-config.json
MODEL_SECRET_ENV_PATH=@CONFIG_FILE@
PROMPT_CONFIG_PATH=@STATE_ROOT@/runtime-config/prompts.json
SEMANTIC_CONFIG_PATH=@INSTALL_ROOT@/current/backend/runtime/config/semantic-config.json
QUERY_TEMPLATE_CONFIG_PATH=@INSTALL_ROOT@/current/backend/runtime/config/query-templates.json
SQL_RESOURCE_DIR=@INSTALL_ROOT@/current/backend/runtime/resources/sql
TEST_CENTER_BASELINE_PATH=@INSTALL_ROOT@/current/backend/runtime/resources/testing/accuracy-baseline.json
CONFIG_HISTORY_DIR=@STATE_ROOT@/config-history
TEST_CENTER_DATA_DIR=@STATE_ROOT@/test-center

# Multiturn V2 remains disabled until it is explicitly enabled for a rollout.
MULTITURN_V2_ENABLED=false
MULTITURN_SHADOW_MODE=false
MULTITURN_GRAY_EXECUTION_ENABLED=false
MULTITURN_GRAY_USER_IDS=
MULTITURN_ROLLOUT_MIN_REVIEWED_SAMPLES=30
MULTITURN_ROLLOUT_MIN_APPROVAL_RATE=0.95
MULTITURN_ROLLOUT_MIN_GRAY_SUCCESS_RATE=0.98
MULTITURN_ROLLOUT_MAX_FALLBACK_RATE=0.05
MULTITURN_ROLLOUT_MAX_FAILURE_RATE=0.01

MODEL_ADMIN_WRITE_ENABLED=true
MODEL_ADMIN_TOKEN_REQUIRED=true
MODEL_ADMIN_TOKEN=<sm4-encrypted-model-admin-token>
TRUSTED_PROXY_TOKEN=<sm4-encrypted-trusted-proxy-token>
BACKEND_NEXT_ALLOW_SCHEMA_CHANGES=false
BACKEND_NEXT_ALLOW_NON_TEST_DATABASE=false

# Digital Rural Commercial Bank unified SSO.
SSO_ENABLED=true
SSO_USER_INFO_URL=https://<digital-rural-host>/yusp-app-oca/api/ssoconfig/userInfo
SSO_TIMEOUT_SECONDS=10
SSO_SOURCE_SYSTEM=jsrcb
