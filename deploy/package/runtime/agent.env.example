# Ask Metric 智能助手服务（pi agent harness）运行配置
# 与 backend.env 同级保存，权限 0640，root:askmetric。
# 本文件由安装器生成一次；升级与回滚不覆盖管理员已修改的值。

# 服务监听（仅回环，由 Nginx 同源 /agent-api 反代）
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=@AGENT_PORT@

# 回答流式展示；默认关闭，灰度开启后可关闭并重启回退。
AGENT_ANSWER_STREAMING=false
# fixed_v1 协议与 AGENT_COMPACT_TURN_ARGS 已退役，不再是配置回退选项。
# 新会话统一使用 semantic_v2 业务协议；旧 fixed 会话保留历史只读，不能继续提问或自动恢复执行。
# 普通取值直接交付：on / observe / off；在新operation接纳时冻结，不改历史记录。
AGENT_DIRECT_QUERY_DELIVERY=on
AGENT_MODEL_TOOL_CHOICE_POLICY=native
# 模型发送副本及提示词可分别回退raw / full；工具Schema、权限和执行契约不变。
AGENT_MODEL_CONTEXT_VIEW=compact_v1
AGENT_SEMANTIC_PROMPT_VARIANT=compact_v1

# FastAPI 后端内网地址；agent 工具调用透传用户 Bearer
BACKEND_BASE_URL=http://127.0.0.1:@BACKEND_PORT@
BACKEND_TIMEOUT_MS=120000

# DeepSeek 官方 OpenAI 兼容接口；如使用行内同协议网关，改为对应地址与密钥。
# 密钥支持 ENC[SM4:v1:...] 密文。
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_NAME=deepseek-flash
AGENT_MODEL_API_KEY=<ENC[SM4:v1:...] 或明文 DeepSeek API Key>
# 官方接口默认开启 thinking；本服务按非思考模式运行以保持确定性。
# 行内网关若使用顶层 enable_thinking，改为 {"enable_thinking":false}。
AGENT_MODEL_EXTRA_BODY={"thinking":{"type":"disabled"}}
AGENT_MODEL_CONTEXT_WINDOW=128000
AGENT_MODEL_MAX_TOKENS=8192
# 首次有效输出等待、输出间空闲时限（毫秒），均默认 30 秒。
AGENT_MODEL_FIRST_RESPONSE_TIMEOUT_MS=30000
AGENT_MODEL_STREAM_IDLE_TIMEOUT_MS=30000
# 非空文本、思考与工具参数输出均刷新空闲计时；响应头和空事件不算进展。
# 持续输出没有固定总时长中断；输出后停滞不会自动重放请求。
# 旧 AGENT_MODEL_TIMEOUT_MS 仅在新空闲变量未设置或为空白时作为空闲时限后备。
# 回滚旧版本时该旧变量恢复总时限语义，新空闲变量不生效，须核对已有 agent.env。

# SM4 主密钥文件（与后端共用；密文与主密钥分开保存）
ASK_METRIC_CONFIG_SM4_KEY_FILE=/etc/ask-metric/config-sm4.key

# 会话治理（原生 JSONL 持久化，重启后恢复；目录随升级保留；单写实例 PID 锁保护）
AGENT_DATA_DIR=@STATE_ROOT@/agent

# 原生压缩（映射 pi CompactionSettings；reserve+keepRecent 必须小于模型窗口）
AGENT_COMPACTION_ENABLED=true
AGENT_COMPACTION_RESERVE_TOKENS=16384
AGENT_COMPACTION_KEEP_RECENT_TOKENS=20000
