# agent-service 本地配置示例；生产环境由 deploy/package 的 agent.env.example 生成

# 服务监听
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8020

# 回答流式展示，最终答案仍以原生快照为准；默认关闭，开启后重启服务。
AGENT_ANSWER_STREAMING=false
# fixed_v1 协议与 AGENT_COMPACT_TURN_ARGS 已退役，不再是配置回退选项。
# 新会话统一使用 semantic_v2 业务协议；旧 fixed 会话保留历史只读，不能继续提问。
# 普通取值的正式结果交付：off保留Pi总结，observe只记录资格，on满足契约后省最后一轮。
# 新operation冻结该策略；已保存交付仍可在关闭后恢复。分析/解释/未完整结果不直出。
AGENT_DIRECT_QUERY_DELIVERY=on
# 网关不兼容 required/function 时设 auto；不影响服务端参数、权限、证据校验。
AGENT_MODEL_TOOL_CHOICE_POLICY=native
# 只改变模型发送副本；raw/full分别恢复旧回执视图和完整语义提示词。
AGENT_MODEL_CONTEXT_VIEW=compact_v1
AGENT_SEMANTIC_PROMPT_VARIANT=compact_v1

# FastAPI 后端内网地址（agent 工具调用透传用户 Bearer）
BACKEND_BASE_URL=http://127.0.0.1:8010
BACKEND_TIMEOUT_MS=120000

# DeepSeek 官方 OpenAI 兼容接口；API Key 支持 ENC[SM4:v1:...] 密文
# 如改回行内网关，同时调整 BASE_URL / NAME / EXTRA_BODY。
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_NAME=deepseek-flash
AGENT_MODEL_API_KEY=
# 鉴权头（默认 Authorization + Bearer 前缀；行内网关如用 accessKey 头则改为下两行）
AGENT_MODEL_AUTH_HEADER=Authorization
AGENT_MODEL_AUTH_PREFIX=Bearer
# 追加在用户消息末尾的后缀（仅特定网关需要，如 Qwen 的 \n/no_think）；官方接口留空
AGENT_MODEL_USER_SUFFIX=
# 并入模型请求体的扩展参数（JSON 对象）。DeepSeek 官方默认开启 thinking；
# 本服务按非思考模式运行，保持 temperature=0 的确定性并避免 reasoning_content 回传要求。
# 行内网关若用顶层 enable_thinking，改为 {"enable_thinking":false}。
AGENT_MODEL_EXTRA_BODY={"thinking":{"type":"disabled"}}
AGENT_MODEL_CONTEXT_WINDOW=128000
AGENT_MODEL_MAX_TOKENS=8192

# 使用 ENC[SM4:v1:...] 密文时配置主密钥（与后端同一机制，二者只配其一）
ASK_METRIC_CONFIG_SM4_KEY_FILE=
ASK_METRIC_CONFIG_SM4_KEY=

# 会话治理（原生 JSONL 持久化，重启后恢复；目录随升级保留）
# 同一数据根只允许一个写实例（启动时 PID 锁保护）；旧格式 JSON 会话只读展示
AGENT_DATA_DIR=./data

# 首次有效输出等待时限（毫秒）：一直未返回有效输出时按重试策略重试，默认最多重试一次。
AGENT_MODEL_FIRST_RESPONSE_TIMEOUT_MS=30000
# 输出空闲时限（毫秒）：每段非空文本、思考或工具参数输出都会刷新计时；响应头、空事件不算进展。
# 持续输出不受固定总时长限制；停顿按既有重试策略重试本次未完成生成，不重放已执行工具。
AGENT_MODEL_STREAM_IDLE_TIMEOUT_MS=30000
# 兼容旧 AGENT_MODEL_TIMEOUT_MS：仅在新空闲变量未设置或为空白时作为空闲时限后备，不再限制总时长。
# 回滚旧版本前检查该旧变量；旧版本会重新把它解释为总时限。

# 模型重试：默认最多重试 1 次、1s 基底退避。
# 首次有效输出前默认只重试一次；调大 MAX_RETRIES 会拉长无响应时的等待。
AGENT_MODEL_RETRY_ENABLED=true
AGENT_MODEL_MAX_RETRIES=1
AGENT_MODEL_RETRY_BASE_DELAY_MS=1000

# 原生压缩（映射 pi CompactionSettings；reserve+keepRecent 必须小于模型窗口）
AGENT_COMPACTION_ENABLED=true
AGENT_COMPACTION_RESERVE_TOKENS=16384
AGENT_COMPACTION_KEEP_RECENT_TOKENS=20000
