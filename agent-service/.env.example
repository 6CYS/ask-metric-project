# agent-service 本地配置示例；生产环境由 deploy/package 的 agent.env.example 生成

# 服务监听
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8020

# FastAPI 后端内网地址（agent 工具调用透传用户 Bearer）
BACKEND_BASE_URL=http://127.0.0.1:8010
BACKEND_TIMEOUT_MS=120000

# 行内 OpenAI 兼容模型网关；API Key 支持 ENC[SM4:v1:...] 密文
AGENT_MODEL_BASE_URL=http://127.0.0.1:9000/v1
AGENT_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash
AGENT_MODEL_API_KEY=
# 鉴权头（默认 Authorization + Bearer 前缀；行内网关如用 accessKey 头则改为下两行）
AGENT_MODEL_AUTH_HEADER=Authorization
AGENT_MODEL_AUTH_PREFIX=Bearer
# 追加在用户消息末尾的后缀（如 Qwen 网关要求 \n/no_think），不需要则留空
AGENT_MODEL_USER_SUFFIX=
# 并入模型请求体的扩展参数（JSON 对象），如 Qwen 关闭思考：{"enable_thinking":false}
AGENT_MODEL_EXTRA_BODY=
AGENT_MODEL_CONTEXT_WINDOW=128000
AGENT_MODEL_MAX_TOKENS=8192

# 使用 ENC[SM4:v1:...] 密文时配置主密钥（与后端同一机制，二者只配其一）
ASK_METRIC_CONFIG_SM4_KEY_FILE=
ASK_METRIC_CONFIG_SM4_KEY=

# 会话治理（原生 JSONL 持久化，重启后恢复；目录随升级保留）
# 同一数据根只允许一个写实例（启动时 PID 锁保护）；旧格式 JSON 会话只读展示
AGENT_DATA_DIR=./data
AGENT_MAX_SESSIONS_PER_USER=20

# 单次模型请求总时限（毫秒）
AGENT_MODEL_TIMEOUT_MS=30000

# 原生压缩（映射 pi CompactionSettings；reserve+keepRecent 必须小于模型窗口）
AGENT_COMPACTION_ENABLED=true
AGENT_COMPACTION_RESERVE_TOKENS=16384
AGENT_COMPACTION_KEEP_RECENT_TOKENS=20000
