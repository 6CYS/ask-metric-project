{
  "name": "ask-metric-agent-service",
  "version": "0.1.0",
  "private": true,
  "description": "Ask Metric 智能助手服务：基于 pi agent harness（pi-ai + pi-agent-core）的问数代理，业务取数只调用 FastAPI 后端受治理接口",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "sm-crypto": "0.5.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
